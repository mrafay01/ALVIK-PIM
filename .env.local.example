# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pim

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>

# NextAuth 2FA (set to "true" to enable email-OTP second factor)
OTP_2FA_ENABLED=false

# Monday.com
MONDAY_API_TOKEN=
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_WEBHOOK_SECRET=

# SharePoint (Microsoft Graph — OAuth2 Client Credentials, Sites.Selected, write)
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
SHAREPOINT_SITE_ID=
SHAREPOINT_IMAGES_LIBRARY_ID=
# Optional: top-level folder for PO documents (one subfolder per PO). Default "Purchase Orders".
SHAREPOINT_PO_FOLDER=

# SMTP: sign-in codes, Help & Support, and every notification email
# (lib/notifications). Without it the app runs but sends no email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Links in notification emails use NEXTAUTH_URL, so set it to the deployed
# address in production.

# Weekly summary email: Vercel Cron (vercel.json) calls
# /api/notifications/digest with "Bearer $CRON_SECRET". Set it in Vercel
# (any long random string). JOBS_WORKER_TOKEN is accepted too.
CRON_SECRET=
JOBS_WORKER_TOKEN=

# Sentry error tracking (optional; errors logged locally if not set)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Logging
LOG_LEVEL=info
# Set to "true" only on hosts with a writable, persistent filesystem
# (not Vercel/serverless) to also write logs to /var/log/pim/*.log
LOG_TO_FILE=false

# Seed scripts
SEED_DOMAIN=example.com
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
