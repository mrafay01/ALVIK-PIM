# next-auth@4 optionally peer-depends on nodemailer@^7 for its built-in
# email-link sign-in provider, which this app doesn't use (only
# CredentialsProvider — see src/lib/auth.ts). nodemailer is pinned to
# ^10.0.10 instead because 7.x has several disclosed high-severity CVEs
# (SMTP command injection, SSRF via disableFileAccess bypass, TLS cert
# validation issues — see `npm audit`); the actual SMTP APIs this app uses
# (createTransport/sendMail) are unchanged across that range. legacy-peer-deps
# is required so npm installs cleanly despite the unmet (and irrelevant)
# peer range — without it, a from-scratch install (Vercel, CI, a fresh
# clone) fails with ERESOLVE even though nothing is actually broken.
legacy-peer-deps=true
